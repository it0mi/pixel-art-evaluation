{
  "runnable_from_root": true,
  "input_root_dir": "web/results/resizeVariety",
  "methods": [
    "area",
    "cubic",
    "lanczos",
    "linear",
    "linearExact",
    "nearest",
    "nearestExact"
  ],
  "default_color_limit": 10,
  "color_limit_enabled": false,
  "output_file": "web/pairs/naive.json",
  "image_extensions": [".png"],
  "shuffle_pairs": true,
  "shuffle_left_right": true
}
